{{ 'component-countdown.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }} .section-inner {
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
  padding-top: {{ section.settings.padding_top | times: 0.8 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.8 }}px;
}

.section-{{ section.id }} .countdown-timer--digits {
  column-gap: {{ section.settings.countdown_digit_spacing }}px;
}

.section-{{ section.id }} .countdown-timer--digits:has(.digit-colon) {
  column-gap: {{ section.settings.countdown_digit_spacing | divided_by: 2 | round: 1 }}px;
}

{% if section.settings.section_margin == 'page-width' %}
.section-{{ section.id }} .section-inner {
  border-radius: {{ section.settings.section_border_radius }}px;
}
.section-{{ section.id }} .countdown-section--bg-image img {
  border-radius: {{ section.settings.section_border_radius }}px;
}
{% endif %}

@media only screen and (min-width: 750px) {
  .section-{{ section.id }} .section-inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{%- endstyle -%}

{% assign heading_html_tag = 'h2' %}
{% if section.index == 1 %}
{% assign heading_html_tag = 'h1' %}  
{% endif %}

{% # theme-check-disable LiquidComplexity %}
<div class="section-{{ section.id }} section-container section-countdown{% if section.settings.completion_hide_section %} section-countdown-hoc{% endif %} {{ section.settings.section_margin }}">
<div class="section-inner {{ section.settings.section_margin }} align-{{ section.settings.content_alignment }} color-scheme-{{ section.settings.text_color }} color-scheme-{{ section.settings.bg_color }}">

<div class="section-countdown--content countdown-layout-mobile--{{ section.settings.layout_mobile }} countdown-layout-desktop--{{ section.settings.layout_desktop }} align--{{ section.settings.content_alignment }}{% if section.settings.section_margin == 'full-width' %} page-width{% endif %}">

  <div class="section-header align-{{ section.settings.content_alignment }}">
    {% unless section.settings.section_label == blank %}<div class="section-label">{{ section.settings.section_label }}</div>{% endunless %}
    {% unless section.settings.heading == blank %}<{{ heading_html_tag }} class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</{{ heading_html_tag }}>{% endunless %}
    {% if section.settings.description != blank %}<div class="section-header-paragraph text-{{ section.settings.text_size }} rte">{{ section.settings.description }}</div>{% endif %}

    {% if section.settings.completion_text != blank %}
    <div class="countdown-timer-expired-message text-{{ section.settings.completion_text_size }} rte">
      {{ section.settings.completion_text }}
    </div>
    {% endif %}

  </div>

  {% assign date_digits = section.settings.target_date | split: '-' %}

  <div class="countdown-timer countdown-timer--font-{{ section.settings.countdown_font_family }}{% if section.settings.show_digit_labels %} countdown-timer--digit-labels{% endif %}{% if section.settings.completion_hide_timer %} countdown-timer--hoc{% endif %}" 
      data-store-time="{{ 'now' | date: '%Y-%m-%dT%H:%M:%S' }}"
      data-year="{{ date_digits[0] }}"
      data-month="{{ date_digits[1] }}"
      data-day="{{ date_digits[2] }}"
      data-hour="{{ section.settings.target_time | split: ":" | first }}"
      data-minute="{{ section.settings.target_time | split: ":" | last }}">
      <div class="countdown-timer--digits">
        <div class="countdown-days">
            <span class="value text-{{ section.settings.number_size }}"></span>
            <span class="digit-label text-{{ section.settings.label_size }}">{{ section.settings.days_label }}</span>
        </div>
        {% if section.settings.show_digit_colons %}<span class="digit-colon dc-days text-{{ section.settings.number_size }}">:</span>{% endif %}
        <div class="countdown-hours">
            <span class="value text-{{ section.settings.number_size }}"></span>
            <span class="digit-label text-{{ section.settings.label_size }}">{{ section.settings.hours_label }}</span>
        </div>
        {% if section.settings.show_digit_colons %}<span class="digit-colon dc-hours text-{{ section.settings.number_size }}">:</span>{% endif %}
        <div class="countdown-minutes">
            <span class="value text-{{ section.settings.number_size }}"></span>
            <span class="digit-label text-{{ section.settings.label_size }}">{{ section.settings.minutes_label }}</span>
        </div>
        {% if section.settings.show_seconds %}
        {% if section.settings.show_digit_colons %}<span class="digit-colon dc-minutes text-{{ section.settings.number_size }}">:</span>{% endif %}
        <div class="countdown-seconds">
            <span class="value text-{{ section.settings.number_size }}"></span>
            <span class="digit-label text-{{ section.settings.label_size }}">{{ section.settings.seconds_label }}</span>
        </div>
        {% endif %}
      </div>
  </div>
  
</div>

<div class="section-footer{% if section.settings.section_margin == 'full-width' %} page-width{% endif %} align-{{ section.settings.content_alignment }} button-color-scheme--{{ section.settings.btn_color_scheme }}">

  {% if section.settings.btn_enable and section.settings.btn_txt != blank %}
    {% if section.settings.btn_style == 'solid' %}
    <a href="{{ section.settings.btn_link }}" role="link" class="button-pre-expiry button button--solid">{{ section.settings.btn_txt }}</a>
    {% endif %}
    {% if section.settings.btn_style == 'outline' %}
    <a href="{{ section.settings.btn_link }}" role="link" class="button-pre-expiry button button--outline">{{ section.settings.btn_txt }}</a>
    {% endif %}
    {% if section.settings.btn_style == 'link_underlined' %}
    <a href="{{ section.settings.btn_link }}" role="link" class="button-pre-expiry link--underlined">{{ section.settings.btn_txt }}</a>
    {% endif %}
  {% endif %}

  {% if section.settings.completion_btn_enable and section.settings.completion_button_text != blank %}
    <div class="countdown-timer-expired-message--button button-color-scheme--{{ section.settings.btn_color_scheme }}">
      <a class="{% unless section.settings.completion_button_style == 'link_underlined' %}button {% endunless %}{{ section.settings.completion_button_style }}" href="{{ section.settings.completion_button_url }}">{{ section.settings.completion_button_text }}</a>
    </div>
  {% endif %}

</div>


{% if section.settings.bg_image != blank %}
<div class="countdown-section--bg-image {{ section.settings.section_margin }}">
  {{ section.settings.bg_image | image_url: width: 2800 | image_tag: loading: 'lazy' }}
</div>
{% endif %}

</div>
</div>

{% # theme-check-enable LiquidComplexity %}

<script>
(function() {

  function initCountdown(root = document) {
    const cdWrapper = root.querySelector('.countdown-timer');

    if (!cdWrapper) return;

    /* Clear existing timer if re-initialising */
    if (cdWrapper.countdownTimer) {
      clearInterval(cdWrapper.countdownTimer);
    }

    /* Store-rendered time -> offset */
    const storeTimeStr = cdWrapper.dataset.storeTime;
    const storeTime = storeTimeStr ? new Date(storeTimeStr) : null;
    const localTime = new Date();
    const timeOffset = storeTime ? (storeTime.getTime() - localTime.getTime()) : 0;

    /* Target time parts */
    const year   = parseInt(cdWrapper.dataset.year, 10);
    const month  = parseInt(cdWrapper.dataset.month, 10) - 1; // 0-based
    const day    = parseInt(cdWrapper.dataset.day, 10);
    const hour   = parseInt(cdWrapper.dataset.hour || '0', 10);
    const minute = parseInt(cdWrapper.dataset.minute || '0', 10);

    /* Build times */
    const storeTargetTime = new Date(year, month, day, hour, minute);
    const adjustedTargetTime = new Date(storeTargetTime.getTime() - timeOffset);

    /* Scoped elements */
    const daysWrap  = cdWrapper.querySelector('.countdown-days');
    const daysVal   = cdWrapper.querySelector('.countdown-days .value');
    const daysColon = cdWrapper.querySelector('.dc-days');
    const hoursEl   = cdWrapper.querySelector('.countdown-hours .value');
    const minutesEl = cdWrapper.querySelector('.countdown-minutes .value');
    const secondsEl = cdWrapper.querySelector('.countdown-seconds .value');

    function updateCountdown() {
      const now = new Date();
      const diff = adjustedTargetTime - now;

      if (diff <= 0) {
        cdWrapper.classList.add('ct-expired');

        if (daysVal)   daysVal.textContent = '00';
        if (hoursEl)   hoursEl.textContent = '00';
        if (minutesEl) minutesEl.textContent = '00';
        if (secondsEl) secondsEl.textContent = '00';

        if (cdWrapper.countdownTimer) {
          clearInterval(cdWrapper.countdownTimer);
        }

        return;
      }

      const days    = Math.floor(diff / 86400000);
      const hours   = Math.floor((diff / 3600000) % 24);
      const minutes = Math.floor((diff / 60000) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      const pad = value => String(value).padStart(2, '0');

      if (daysVal)   daysVal.textContent = pad(days);
      if (hoursEl)   hoursEl.textContent = pad(hours);
      if (minutesEl) minutesEl.textContent = pad(minutes);
      if (secondsEl) secondsEl.textContent = pad(seconds);

      if (daysWrap) {
        daysWrap.style.display = days === 0 ? 'none' : 'inline-block';
      }

      if (daysColon) {
        daysColon.style.display = days === 0 ? 'none' : 'inline-block';
      }
    }

    updateCountdown();

    cdWrapper.countdownTimer = setInterval(updateCountdown, 250);
  }

  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.section-countdown');

    if (section) {
      initCountdown(section);
    }
  });

  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initCountdown(event.target);
      }
    });
  }

})();
</script>

