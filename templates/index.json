    "collapsible_content_cHpXzB": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_J4T9Wb": {
          "type": "collapsible_row",
          "settings": {
            "title": "What exactly is JAX?",
            "content": "<p>JAX is a portable liquid THC drop you can add to any drink. One click of the device delivers a precise dose of hemp-derived delta-9 THC — tasteless, odorless, and fast-acting. Think of it as the social alternative to alcohol.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_CMYtrV": {
          "type": "collapsible_row",
          "settings": {
            "title": "What does it feel like?",
            "content": "<p>A relaxed, social buzz — similar to the feeling of a drink or two, without the alcohol. Most people feel it within 5–15 minutes.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_GEYCB8": {
          "type": "collapsible_row",
          "settings": {
            "title": "Will it change the taste of my drink?",
            "content": "<p>No. JAX is completely tasteless and odorless. Add it to water, juice, a mocktail, or anything else — you won't notice it's there.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_JxNExd": {
          "type": "collapsible_row",
          "settings": {
            "title": "How is this different from an edible?",
            "content": "<p>Edibles take 45–90 minutes and are famously hard to dose. JAX is built for social settings: faster onset, one-milligram precision, and it fits in your pocket.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "heading_Wc3aCb": {
          "type": "heading",
          "settings": {
            "group_heading": "Dosing"
          }
        },
        "collapsible_row_3HWLeq": {
          "type": "collapsible_row",
          "settings": {
            "title": "How much should I take?",
            "content": "<p>Start with one shot (1mg THC). Wait 15 minutes before adding more. JAX is built around control — you can always add more.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_yrPAxi": {
          "type": "collapsible_row",
          "settings": {
            "title": "Can I mix it with alcohol?",
            "content": "<p>We don't recommend it. THC and alcohol together can intensify effects in unpredictable ways. JAX is designed as an alternative to alcohol, not a mixer with it.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_djFrjq": {
          "type": "collapsible_row",
          "settings": {
            "title": "What if I take too much?",
            "content": "<p>Find a comfortable place to sit, drink water, and don't panic — the feeling will pass. Start low next time. This is exactly why JAX is built around precise, one-shot dosing.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "heading_pfhGbC": {
          "type": "heading",
          "settings": {
            "group_heading": "Safety & Legality"
          }
        },
        "collapsible_row_CHgrQa": {
          "type": "collapsible_row",
          "settings": {
            "title": "Is JAX legal?",
            "content": "<p>Yes. JAX uses hemp-derived delta-9 THC that complies with the federal legal limit under the 2018 Farm Bill. However, state laws vary — check your local regulations before purchasing.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_hUfWMA": {
          "type": "collapsible_row",
          "settings": {
            "title": "Is it safe to drive after using JAX?",
            "content": "<p>No. THC impairs your ability to drive. Treat it like alcohol — don't drive, operate machinery, or make important decisions after use.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_RKi6Lk": {
          "type": "collapsible_row",
          "settings": {
            "title": "Who shouldn’t use JAX?",
            "content": "<p>Anyone under 21, pregnant or nursing individuals, people on medications that may interact with cannabinoids, or anyone with a sensitivity to THC. When in doubt, consult a doctor before use.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "heading_FyxkqU": {
          "type": "heading",
          "settings": {
            "group_heading": "Product & Ordering"
          }
        },
        "collapsible_row_Qy4AYC": {
          "type": "collapsible_row",
          "settings": {
            "title": "Will it ship to my state?",
            "content": "<p>We ship to 44 states. We don’t ship to AK, HI, ID, IA, ND, OH.&nbsp;</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_n9dmMa": {
          "type": "collapsible_row",
          "settings": {
            "title": "How long does a pod last?",
            "content": "<p>The JAX Elixir holds 50 shots per pod. How long that lasts depends on how many shots per a drink, whether you share it and how often you use it.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_XGTzhQ": {
          "type": "collapsible_row",
          "settings": {
            "title": "Are the pods refillable?",
            "content": "<p>Pods are designed to be interchangeable across the JAX device. <a href=\"/products/jax-pods\" target=\"_blank\" title=\"JAX Elixir Pods\">Refill pods are sold separately.</a></p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_dBbgHL": {
          "type": "collapsible_row",
          "settings": {
            "title": "Can I use JAX in public or at a bar?",
            "content": "<p>JAX is discreet and portable by design. It's also TSA compliant.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        }
      },
