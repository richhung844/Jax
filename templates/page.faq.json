          "type": "collapsible_row",
          "settings": {
            "title": "What does it feel like?",
            "content": "<p>A relaxed, social buzz — similar to the feeling of a drink or two, without the alcohol. Most people feel it within 5–15 minutes.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_DUQ4MT": {
          "type": "collapsible_row",
          "settings": {
            "title": "Will it change the taste of my drink?",
            "content": "<p>No. JAX is completely tasteless and odorless. Add it to water, juice, a mocktail, or anything else — you won't notice it's there.</p>",
            "media_ratio": "fit",
            "media_width": 50
          }
        },
        "collapsible_row_jqDGrQ": {
          "type": "collapsible_row",
          "settings": {
            "title": "How is this different from an edible?",
            "content": "<p>Edibles can take 45–90 minutes to kick in and are notoriously hard to dose. JAX is designed for social settings — faster onset, precise dosing, and easy to bring anywhere. You're in control from the first click.</p>",
            "media_ratio": "fit",
            "media_width": 50
