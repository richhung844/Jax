    {"type":"select","id":"icons_per_row","label":"Icons per row","options":[{"value":"1","label":"1"},{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"4"},
    {"type":"select","id":"mobile_icon_layout","label":"Mobile layout","options":[{"value":"row","label":"Keep row"},{"value":"stack","label":"2-column grid"}],"default":"stack"},
    {"type":"select","id":"icon_alignment","label":"Icon alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"select","id":"icon_text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"range","id":"icon_gap","label":"Icon gap","min":0,"max":40,"step":4,"unit":"px","default":16},
    {"type":"range","id":"icon_top_spacing","label":"Top spacing","min":0,"max":40,"step":4,"unit":"px","default":20},
    {"type":"range","id":"icon_size","label":"Icon size","min":16,"max":64,"step":4,"unit":"px","default":32},
    {"type":"color","id":"benefit_heading_color","label":"Heading color","default":"#000000"},
    {"type":"color","id":"benefit_text_color","label":"Benefit text color","default":"#444444"},
    {"type":"image_picker","id":"benefit_1_image","label":"Icon 1 image"},{"type":"text","id":"benefit_1_heading","label":"Icon 1 heading"},{"type":"text","id":"benefit_1_text","label":"Icon 1 text"},{"type":"url","id":"benefit_1_link","label":"Icon 1 link"},
    {"type":"image_picker","id":"benefit_2_image","label":"Icon 2 image"},{"type":"text","id":"benefit_2_heading","label":"Icon 2 heading"},{"type":"text","id":"benefit_2_text","label":"Icon 2 text"},{"type":"url","id":"benefit_2_link","label":"Icon 2 link"},
    {"type":"image_picker","id":"benefit_3_image","label":"Icon 3 image"},{"type":"text","id":"benefit_3_heading","label":"Icon 3 heading"},{"type":"text","id":"benefit_3_text","label":"Icon 3 text"},{"type":"url","id":"benefit_3_link","label":"Icon 3 link"},
    {"type":"image_picker","id":"benefit_4_image","label":"Icon 4 image"},{"type":"text","id":"benefit_4_heading","label":"Icon 4 heading"},{"type":"text","id":"benefit_4_text","label":"Icon 4 text"},{"type":"url","id":"benefit_4_link","label":"Icon 4 link"}
  ],
  "presets":[{"name":"Featured product card"}],
  "tag":null,
  "class":"featured-product-card"
