{% doc %}
  @prompt
    Create a fully responsive comparison table section. The design should have a premium, minimal, editorial feel.
    
    Layout
    
    Dark charcoal background (#3E3B3A)
    Large bold centered heading at the top:
    "You don't have to be a control freak, to prefer being in control"
    Use an all-caps condensed font for the heading.
    Below the heading, create a comparison table with 6 columns:
    Feature (left column)
    JAX (highlighted)
    Alcohol
    Gummies & Edibles
    Canned THC Drinks
    Droppers & Packets
    
    Table Styling
    
    First column should be approximately 28–30% width.
    Remaining columns evenly distributed.
    Horizontal divider lines between every row.
    No vertical borders except for the highlighted JAX column.
    Plenty of whitespace and generous row height (90–120px).
    Table should be centered with a max width around 1200–1300px.
    
    Highlighted JAX Column
    
    Give the entire JAX column a warm cream background (#EEE8DB).
    Add slight rounded corners (8px).
    Display the JAX logo at the top of this column.
    The highlight should extend the full height of the table.
    
    Icons
    
    Use olive green circular check icons (#8E9569) with white checkmarks.
    Use outlined white X icons for unavailable features.
    Icons should be perfectly centered within each cell.
    
    Feature Rows
    
    Dose control — you dial it, one milligram at a time
    Onset — 5–15 minutes
    Taste impact — none; your drink stays your drink
    Discretion and portability
    No morning after or next-day tax
    
    Data
    
    JAX: checkmark on every row.
    Alcohol: X for every row.
    Gummies & Edibles: only "Taste impact" gets a green check; all others X.
    Canned THC Drinks: X for every row.
    Droppers & Packets: X for every row.
    
    Typography
    
    White text throughout except inside the cream JAX column.
    Feature text: medium weight, left aligned.
    Column headings: uppercase with slight letter spacing.
    Maintain generous spacing for a premium luxury brand aesthetic.
    
    Responsive Behavior
    
    On desktop, display as a full comparison table.
    On tablet, slightly reduce spacing while preserving all six columns.
    On mobile, convert to a horizontally scrollable table with the JAX column remaining visually highlighted.
    Preserve icon alignment and readability on all screen sizes.
    
    Customization
    
    Make every heading, feature label, checkmark, and X configurable through Shopify section settings or blocks.
    Allow merchants to add or remove rows.
    Allow changing column titles.
    Allow uploading the highlighted column logo.
    Allow changing background colors, accent color, text colors, and icon colors through the Theme Editor.
    Build as an OS 2.0 section using semantic HTML, CSS, and Liquid with no external libraries.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: 84px 24px 96px;
    overflow: hidden;
  }

  .ai-comparison-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .ai-comparison-{{ ai_gen_id }}__title {
    max-width: 920px;
    margin: 0 auto 64px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-align: center;
    text-transform: uppercase;
  }

  .ai-comparison-{{ ai_gen_id }}__scroller {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-color: {{ block.settings.accent_color }} transparent;
  }

  .ai-comparison-{{ ai_gen_id }}__table {
    width: 100%;
    min-width: 920px;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .ai-comparison-{{ ai_gen_id }} th,
  .ai-comparison-{{ ai_gen_id }} td {
    padding: 25px 18px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
    vertical-align: middle;
  }

  .ai-comparison-{{ ai_gen_id }} th {
    height: 94px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .ai-comparison-{{ ai_gen_id }} th:first-child,
  .ai-comparison-{{ ai_gen_id }} td:first-child {
    width: 29%;
    padding-left: 0;
    text-align: left;
  }

  .ai-comparison-{{ ai_gen_id }} th:not(:first-child),
  .ai-comparison-{{ ai_gen_id }} td:not(:first-child) {
    width: 14.2%;
  }

  .ai-comparison-{{ ai_gen_id }} td {
    height: 108px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.35;
    text-align: center;
  }

  .ai-comparison-{{ ai_gen_id }} td:first-child {
    font-weight: 500;
  }

  .ai-comparison-{{ ai_gen_id }} .ai-comparison-{{ ai_gen_id }}__jax {
    background: {{ block.settings.highlight_color }};
    color: {{ block.settings.highlight_text_color }};
    border-left: 1px solid {{ block.settings.highlight_color }};
    border-right: 1px solid {{ block.settings.highlight_color }};
  }

  .ai-comparison-{{ ai_gen_id }} th.ai-comparison-{{ ai_gen_id }}__jax {
    border-radius: 8px 8px 0 0;
  }

  .ai-comparison-{{ ai_gen_id }} tr:last-child td {
    border-bottom: 0;
  }

  .ai-comparison-{{ ai_gen_id }} tr:last-child td.ai-comparison-{{ ai_gen_id }}__jax {
    border-radius: 0 0 8px 8px;
  }

  .ai-comparison-{{ ai_gen_id }}__logo {
    display: block;
    width: 82px;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .ai-comparison-{{ ai_gen_id }}__logo-placeholder {
    width: 82px;
    height: 28px;
    margin: 0 auto;
    color: {{ block.settings.highlight_text_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__logo-placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-comparison-{{ ai_gen_id }}__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 19px;
    font-weight: 700;
    line-height: 1;
  }

  .ai-comparison-{{ ai_gen_id }}__icon--check {
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.checkmark_color }};
  }

  .ai-comparison-{{ ai_gen_id }}__icon--x {
    color: {{ block.settings.x_color }};
    font-size: 25px;
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-{{ ai_gen_id }} {
      padding: 56px 16px 64px;
    }

    .ai-comparison-{{ ai_gen_id }}__title {
      margin-bottom: 42px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-comparison-{{ ai_gen_id }} th,
    .ai-comparison-{{ ai_gen_id }} td {
      padding: 20px 14px;
    }

    .ai-comparison-{{ ai_gen_id }} td {
      height: 92px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-{{ ai_gen_id }}__inner">
    <h2 class="ai-comparison-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
    <div class="ai-comparison-{{ ai_gen_id }}__scroller" tabindex="0" aria-label="Comparison table. Scroll horizontally to view all columns.">
      <table class="ai-comparison-{{ ai_gen_id }}__table">
        <thead>
          <tr>
            <th scope="col">{{ block.settings.feature_heading }}</th>
            <th scope="col" class="ai-comparison-{{ ai_gen_id }}__jax">
              {% if block.settings.logo %}
                <img class="ai-comparison-{{ ai_gen_id }}__logo" src="{{ block.settings.logo | image_url: width: 240 }}" alt="{{ block.settings.jax_heading | escape }}" loading="lazy">
              {% else %}
                <div class="ai-comparison-{{ ai_gen_id }}__logo-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
              <span>{{ block.settings.jax_heading }}</span>
            </th>
            <th scope="col">{{ block.settings.alcohol_heading }}</th>
            <th scope="col">{{ block.settings.gummies_heading }}</th>
            <th scope="col">{{ block.settings.drinks_heading }}</th>
            <th scope="col">{{ block.settings.droppers_heading }}</th>
          </tr>
        </thead>
        <tbody>
          {% for i in (1..5) %}
            {% liquid
              assign label_key = 'row_' | append: i | append: '_label'
              assign detail_key = 'row_' | append: i | append: '_detail'
              assign gummies_key = 'row_' | append: i | append: '_gummies_check'
              assign row_label = block.settings[label_key]
              assign row_detail = block.settings[detail_key]
              assign gummies_check = block.settings[gummies_key]
            %}
            <tr>
              <th scope="row">{{ row_label }}{% if row_detail != blank %}<br><span>{{ row_detail }}</span>{% endif %}</th>
              <td class="ai-comparison-{{ ai_gen_id }}__jax"><span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--check" aria-label="{{ block.settings.check_label }}">{{ block.settings.checkmark }}</span></td>
              <td><span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--x" aria-label="{{ block.settings.x_label }}">{{ block.settings.x_mark }}</span></td>
              <td>{% if gummies_check %}<span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--check" aria-label="{{ block.settings.check_label }}">{{ block.settings.checkmark }}</span>{% else %}<span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--x" aria-label="{{ block.settings.x_label }}">{{ block.settings.x_mark }}</span>{% endif %}</td>
              <td><span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--x" aria-label="{{ block.settings.x_label }}">{{ block.settings.x_mark }}</span></td>
              <td><span class="ai-comparison-{{ ai_gen_id }}__icon ai-comparison-{{ ai_gen_id }}__icon--x" aria-label="{{ block.settings.x_label }}">{{ block.settings.x_mark }}</span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": null,
  "class": "comparison-table-block",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"You don't have to be a control freak, to prefer being in control"},
    {"type":"text","id":"feature_heading","label":"Feature heading","default":"Feature"},
    {"type":"text","id":"jax_heading","label":"JAX heading","default":"JAX"},
    {"type":"text","id":"alcohol_heading","label":"Alcohol heading","default":"Alcohol"},
    {"type":"text","id":"gummies_heading","label":"Gummies heading","default":"Gummies & Edibles"},
    {"type":"text","id":"drinks_heading","label":"Drinks heading","default":"Canned THC Drinks"},
    {"type":"text","id":"droppers_heading","label":"Droppers heading","default":"Droppers & Packets"},
    {"type":"image_picker","id":"logo","label":"JAX logo"},
    {"type":"header","content":"Rows"},
    {"type":"text","id":"row_1_label","label":"Row 1 label","default":"Dose control"},
    {"type":"text","id":"row_1_detail","label":"Row 1 detail","default":"you dial it, one milligram at a time"},
    {"type":"checkbox","id":"row_1_gummies_check","label":"Row 1 gummies check","default":false},
    {"type":"text","id":"row_2_label","label":"Row 2 label","default":"Onset"},
    {"type":"text","id":"row_2_detail","label":"Row 2 detail","default":"5–15 minutes"},
    {"type":"checkbox","id":"row_2_gummies_check","label":"Row 2 gummies check","default":false},
    {"type":"text","id":"row_3_label","label":"Row 3 label","default":"Taste impact"},
    {"type":"text","id":"row_3_detail","label":"Row 3 detail","default":"none; your drink stays your drink"},
    {"type":"checkbox","id":"row_3_gummies_check","label":"Row 3 gummies check","default":true},
    {"type":"text","id":"row_4_label","label":"Row 4 label","default":"Discretion and portability"},
    {"type":"text","id":"row_4_detail","label":"Row 4 detail","default":"Ready when you are"},
    {"type":"checkbox","id":"row_4_gummies_check","label":"Row 4 gummies check","default":false},
    {"type":"text","id":"row_5_label","label":"Row 5 label","default":"No morning after or next-day tax"},
    {"type":"text","id":"row_5_detail","label":"Row 5 detail","default":"Feel like yourself tomorrow"},
    {"type":"checkbox","id":"row_5_gummies_check","label":"Row 5 gummies check","default":false},
    {"type":"header","content":"Icons"},
    {"type":"text","id":"checkmark","label":"Checkmark","default":"✓"},
    {"type":"text","id":"x_mark","label":"X mark","default":"×"},
    {"type":"text","id":"check_label","label":"Check accessible label","default":"Available"},
    {"type":"text","id":"x_label","label":"X accessible label","default":"Unavailable"},
    {"type":"header","content":"Style"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"sans-serif"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},
    {"type":"range","id":"heading_size","label":"Heading size","min":24,"max":80,"step":2,"unit":"px","default":56},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":48,"step":2,"unit":"px","default":32},
    {"type":"range","id":"body_size","label":"Body size","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"color","id":"background_color","label":"Background","default":"#3E3B3A"},
    {"type":"color","id":"highlight_color","label":"JAX background","default":"#EEE8DB"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},
    {"type":"color","id":"highlight_text_color","label":"JAX text","default":"#3E3B3A"},
    {"type":"color","id":"accent_color","label":"Check background","default":"#8E9569"},
    {"type":"color","id":"checkmark_color","label":"Checkmark color","default":"#FFFFFF"},
    {"type":"color","id":"x_color","label":"X color","default":"#FFFFFF"},
    {"type":"color","id":"divider_color","label":"Dividers","default":"#6B6765"}
  ],
  "presets": [{"name":"Comparison table"}]
}
{% endschema %}