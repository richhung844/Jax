{% doc %}
  @prompt
    Create a customizable Shopify Featured Collection section with responsive product cards and variant selection.
    
    DEFAULT CARD LAYOUT:
    1. Product title above image
    2. Product image
    3. Price below image
    4. Editable custom description text
    5. Variant selector
    6. Quick Add button
    
    FEATURED COLLECTION SETTINGS:
    - Collection picker
    - Heading/description
    - Products shown
    - Desktop/mobile columns
    - Card spacing and section padding
    - Optional View All button
    
    PRODUCT CARDS:
    - Product title above image
    - Product image
    - Dynamic price directly below image
    - Editable custom description for each product card
    - Variant selector
    - Quick Add
    - Show/hide controls for card elements
    
    Allow the custom description text to be individually edited for each product card in the Theme Editor rather than automatically pulling from the product description.
    
    VARIANTS:
    Display variants directly on cards as buttons, pills, swatches, or dropdowns. Clearly show selected and sold-out variants.
    
    When a variant is selected, dynamically update:
    - Price/compare-at price
    - Variant image
    - Availability
    - Selected variant ID
    - Quick Add button
    
    Quick Add must add the selected variant. Do not show duplicate prices when variants change.
    
    DESIGN SETTINGS:
    Include controls for image ratio/fit, card padding, spacing, border/radius, title/price/description sizing, variant style, button style, and text alignment.
    
    MOBILE:
    Fully responsive with mobile column and spacing controls. Variant selectors must not overflow.
    
    Use Shopify Liquid, CSS, and JavaScript compatible with Online Store 2.0. Use dynamic Shopify product/variant data with no hard-coded products or variants. Each card must function independently.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .fc-{{ ai_gen_id }} { display:block; width:100%; box-sizing:border-box; padding:{{ block.settings.section_padding }}px 0; }
  .fc-{{ ai_gen_id }} *, .fc-{{ ai_gen_id }} *::before, .fc-{{ ai_gen_id }} *::after { box-sizing:border-box; }
  .fc-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; }
  .fc-{{ ai_gen_id }}__head { margin-bottom:24px; text-align:{{ block.settings.alignment }}; }
  .fc-{{ ai_gen_id }}__heading { margin:0 0 8px; font-size:{{ block.settings.heading_size }}px; }
  .fc-{{ ai_gen_id }}__intro { margin:0; }
  .fc-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat({{ block.settings.desktop_columns }},minmax(0,1fr)); gap:{{ block.settings.gap }}px; }
  .fc-{{ ai_gen_id }}__card { min-width:0; padding:{{ block.settings.card_padding }}px; border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }}; border-radius:{{ block.settings.radius }}px; background:{{ block.settings.card_background }}; text-align:{{ block.settings.alignment }}; }
  .fc-{{ ai_gen_id }}__title { display:block; color:inherit; text-decoration:none; font-size:{{ block.settings.title_size }}px; margin:0 0 10px; }
  .fc-{{ ai_gen_id }}__media { display:block; position:relative; overflow:hidden; border-radius:{{ block.settings.image_radius }}px; aspect-ratio:{{ block.settings.image_ratio }}; background:#f3f3f3; }
  .fc-{{ ai_gen_id }}__media img { width:100%; height:100%; display:block; object-fit:{{ block.settings.image_fit }}; }
  .fc-{{ ai_gen_id }}__media--fit { aspect-ratio:auto; }
  .fc-{{ ai_gen_id }}__media--fit img { height:auto; }
  .fc-{{ ai_gen_id }}__placeholder { width:100%; aspect-ratio:{{ block.settings.image_ratio }}; background:#f3f3f3; }
  .fc-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; display:block; }
  .fc-{{ ai_gen_id }}__price { margin:12px 0 8px; font-size:{{ block.settings.price_size }}px; }
  .fc-{{ ai_gen_id }}__compare { margin-left:8px; text-decoration:line-through; opacity:.7; }
  .fc-{{ ai_gen_id }}__desc { margin:0 0 12px; font-size:{{ block.settings.description_size }}px; }
  .fc-{{ ai_gen_id }}__variants { display:flex; flex-wrap:wrap; justify-content:{% if block.settings.alignment == 'center' %}center{% elsif block.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; gap:6px; margin:12px 0; }
  .fc-{{ ai_gen_id }}__variant { max-width:100%; padding:8px 10px; border:1px solid {{ block.settings.border_color }}; border-radius:{% if block.settings.variant_style == 'pills' %}999px{% else %}{{ block.settings.radius }}px{% endif %}; color:inherit; background:transparent; cursor:pointer; font:inherit; font-size:13px; overflow-wrap:anywhere; }
  .fc-{{ ai_gen_id }}__variant[aria-pressed="true"] { color:#fff; background:#111; border-color:#111; }
  .fc-{{ ai_gen_id }}__variant:disabled { opacity:.5; text-decoration:line-through; cursor:not-allowed; }
  .fc-{{ ai_gen_id }}__quick { width:100%; min-height:44px; padding:10px 14px; border:1px solid {{ block.settings.button_background }}; border-radius:{{ block.settings.button_radius }}px; color:{{ block.settings.button_text }}; background:{{ block.settings.button_background }}; cursor:pointer; font:inherit; }
  .fc-{{ ai_gen_id }}__quick:disabled { opacity:.55; cursor:not-allowed; }
  .fc-{{ ai_gen_id }}__status { min-height:1.3em; margin:6px 0 0; font-size:13px; }
  .fc-{{ ai_gen_id }}__footer { margin-top:24px; text-align:center; }
  .fc-{{ ai_gen_id }}__view-all { display:inline-block; padding:11px 20px; border:1px solid currentColor; color:inherit; text-decoration:none; border-radius:{{ block.settings.button_radius }}px; }
  @media(max-width:749px) { .fc-{{ ai_gen_id }}__grid { grid-template-columns:repeat({{ block.settings.mobile_columns }},minmax(0,1fr)); gap:{{ block.settings.mobile_gap }}px; } .fc-{{ ai_gen_id }}__inner { width:100%; } }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="fc-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="fc-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank or block.settings.description != blank %}<div class="fc-{{ ai_gen_id }}__head">{% if block.settings.heading != blank %}<h2 class="fc-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="fc-{{ ai_gen_id }}__intro">{{ block.settings.description }}</div>{% endif %}</div>{% endif %}
    {% if block.settings.collection != blank %}
      {% assign featured_products = block.settings.collection.products %}
      <div class="fc-{{ ai_gen_id }}__grid">
        {% for product in featured_products limit: block.settings.products_to_show %}
          {% assign custom_description_key = 'card_description_' | append: forloop.index %}
          {% assign custom_description = block.settings[custom_description_key] %}
          {% assign current_variant = product.selected_or_first_available_variant | default: product.variants.first %}
          <article class="fc-{{ ai_gen_id }}__card" data-product-card>
            {% if block.settings.show_title %}<a class="fc-{{ ai_gen_id }}__title" href="{{ product.url }}">{{ product.title | escape }}</a>{% endif %}
            {% if block.settings.show_image %}<a class="fc-{{ ai_gen_id }}__media{% if block.settings.image_ratio == 'auto' %} fc-{{ ai_gen_id }}__media--fit{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}<img data-product-image src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="fc-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a>{% endif %}
            {% if block.settings.show_price %}<div class="fc-{{ ai_gen_id }}__price" data-price>{{ current_variant.price | money }}{% if current_variant.compare_at_price > current_variant.price %}<span class="fc-{{ ai_gen_id }}__compare" data-compare>{{ current_variant.compare_at_price | money }}</span>{% else %}<span class="fc-{{ ai_gen_id }}__compare" data-compare hidden></span>{% endif %}</div>{% endif %}
            {% if block.settings.show_description and custom_description != blank %}<div class="fc-{{ ai_gen_id }}__desc">{{ custom_description }}</div>{% endif %}
            {% if block.settings.show_variants and product.variants.size > 1 %}<div class="fc-{{ ai_gen_id }}__variants" role="group" aria-label="Choose a variant">{% for variant in product.variants %}<button type="button" class="fc-{{ ai_gen_id }}__variant" data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}" data-compare-price="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 900 }}{% endif %}" aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</button>{% endfor %}</div>{% endif %}
            {% if block.settings.show_quick_add %}<form data-quick-form><input type="hidden" name="id" value="{{ current_variant.id }}" data-selected-id><button class="fc-{{ ai_gen_id }}__quick" type="submit" data-quick-button {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ block.settings.button_label | escape }}{% else %}Sold out{% endif %}</button><p class="fc-{{ ai_gen_id }}__status" aria-live="polite" data-status></p></form>{% endif %}
            <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
          </article>
        {% else %}<p>No products found in this collection.</p>{% endfor %}
      </div>
      {% if block.settings.show_view_all %}<div class="fc-{{ ai_gen_id }}__footer"><a class="fc-{{ ai_gen_id }}__view-all" href="{{ block.settings.collection.url }}">{{ block.settings.view_all_label | escape }}</a></div>{% endif %}
    {% else %}<p>Select a collection to display products.</p>{% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
(function(){
  const tag='featured-collection-{{ ai_gen_id }}';
  if(customElements.get(tag)) return;
  class FeaturedCollection extends HTMLElement {
    connectedCallback(){
      this.cards=this.querySelectorAll('[data-product-card]');
      this.cards.forEach(card=>{
        const buttons=card.querySelectorAll('[data-variant-id]');
        const idInput=card.querySelector('[data-selected-id]');
        const quick=card.querySelector('[data-quick-button]');
        const price=card.querySelector('[data-price]');
        const compare=card.querySelector('[data-compare]');
        const image=card.querySelector('[data-product-image]');
        const status=card.querySelector('[data-status]');
        buttons.forEach(button=>button.addEventListener('click',()=>{
          buttons.forEach(item=>item.setAttribute('aria-pressed','false'));
          button.setAttribute('aria-pressed','true');
          idInput.value=button.dataset.variantId;
          const amount=Number(button.dataset.price);
          if(price){
            const formatted=new Intl.NumberFormat(document.documentElement.lang||'en-US',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}).format(amount/100);
            price.childNodes[0].textContent=formatted;
          }
          const compareAmount=Number(button.dataset.comparePrice);
          if(compare){if(compareAmount>amount){compare.textContent=new Intl.NumberFormat(document.documentElement.lang||'en-US',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}).format(compareAmount/100);compare.hidden=false;}else{compare.textContent='';compare.hidden=true;}}
          if(image&&button.dataset.image) image.src=button.dataset.image;
          if(quick){quick.disabled=button.dataset.available!=='true';quick.textContent=quick.disabled?'Sold out':{{ block.settings.button_label | json }};}
        }));
        const form=card.querySelector('[data-quick-form]');
        if(form) form.addEventListener('submit',async event=>{
          event.preventDefault();
          if(!idInput.value||quick.disabled) return;
          quick.disabled=true;
          const original=quick.textContent;
          status.textContent='Adding…';
          try{
            const response=await fetch(`${window.Shopify.routes.root}cart/add.js`,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:Number(idInput.value),quantity:1})});
            if(!response.ok) throw new Error('Unable to add this item.');
            await response.json();
            status.textContent='Added to cart';
            quick.textContent='Added';
            document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));
            setTimeout(()=>{quick.textContent=original;quick.disabled=false;},1600);
          }catch(error){status.textContent=error.message;quick.disabled=false;}
        });
      });
    }
  }
  customElements.define(tag,FeaturedCollection);
})();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"text","id":"heading","label":"Heading","default":"Featured collection"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Explore our selected products.</p>"},
    {"type":"range","id":"products_to_show","label":"Products shown","min":2,"max":16,"step":1,"default":8},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"desktop_columns","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},
    {"type":"select","id":"mobile_columns","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},
    {"type":"range","id":"gap","label":"Card spacing","min":0,"max":40,"step":4,"unit":"px","default":20},
    {"type":"range","id":"mobile_gap","label":"Mobile spacing","min":0,"max":24,"step":2,"unit":"px","default":12},
    {"type":"range","id":"section_padding","label":"Section padding","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"header","content":"Product card"},
    {"type":"checkbox","id":"show_title","label":"Show title","default":true},
    {"type":"checkbox","id":"show_image","label":"Show image","default":true},
    {"type":"checkbox","id":"show_price","label":"Show price","default":true},
    {"type":"checkbox","id":"show_description","label":"Show custom descriptions","default":true},
    {"type":"checkbox","id":"show_variants","label":"Show variants","default":true},
    {"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true},
    {"type":"textarea","id":"card_description_1","label":"Product 1 custom description"},
    {"type":"textarea","id":"card_description_2","label":"Product 2 custom description"},
    {"type":"textarea","id":"card_description_3","label":"Product 3 custom description"},
    {"type":"textarea","id":"card_description_4","label":"Product 4 custom description"},
    {"type":"textarea","id":"card_description_5","label":"Product 5 custom description"},
    {"type":"textarea","id":"card_description_6","label":"Product 6 custom description"},
    {"type":"textarea","id":"card_description_7","label":"Product 7 custom description"},
    {"type":"textarea","id":"card_description_8","label":"Product 8 custom description"},
    {"type":"header","content":"Card style"},
    {"type":"range","id":"card_padding","label":"Card padding","min":0,"max":32,"step":2,"unit":"px","default":12},
    {"type":"range","id":"border_width","label":"Border width","min":0,"max":4,"step":1,"unit":"px","default":1},
    {"type":"color","id":"border_color","label":"Border color","default":"#dddddd"},
    {"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},
    {"type":"range","id":"radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":8},
    {"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 2","label":"Landscape"},{"value":"auto","label":"Adapt to image"}],"default":"1 / 1"},
    {"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Fill"},{"value":"contain","label":"Fit"}],"default":"cover"},
    {"type":"range","id":"image_radius","label":"Image radius","min":0,"max":32,"step":2,"unit":"px","default":4},
    {"type":"range","id":"title_size","label":"Title size","min":12,"max":28,"step":1,"unit":"px","default":16},
    {"type":"range","id":"price_size","label":"Price size","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"range","id":"description_size","label":"Description size","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":28},
    {"type":"select","id":"variant_style","label":"Variant style","options":[{"value":"pills","label":"Pills"},{"value":"square","label":"Buttons"}],"default":"pills"},
    {"type":"header","content":"Buttons"},
    {"type":"text","id":"button_label","label":"Quick add label","default":"Quick add"},
    {"type":"color","id":"button_background","label":"Background","default":"#111111"},
    {"type":"color","id":"button_text","label":"Text","default":"#ffffff"},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":32,"step":2,"unit":"px","default":4},
    {"type":"checkbox","id":"show_view_all","label":"Show view all button","default":false},
    {"type":"text","id":"view_all_label","label":"View all label","default":"View all"}
  ],
  "presets": [{"name":"Featured collection"}],
  "tag": null,
  "class": "featured-collection-block"
}
{% endschema %}