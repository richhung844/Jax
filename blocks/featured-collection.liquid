e":"checkbox","id":"show_price_description","label":"Show variant price description","default":true},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"checkbox","id":"show_learn_more","label":"Show Learn More link","default":false},{"type":"checkbox","id":"show_variants","label":"Show variant buttons","default":true},{"type":"checkbox","id":"show_add_button","label":"Show Add to Bag","default":true},{"type":"text","id":"learn_label","label":"Learn More label","default":"Learn more"},{"type":"text","id":"add_label","label":"Add button label","default":"Add to Bag"},{"type":"text","id":"success_label","label":"Added confirmation","default":"Added to bag"},{"type":"richtext","id":"description_1","label":"Product 1 description"},{"type":"richtext","id":"description_2","label":"Product 2 description"},{"type":"richtext","id":"description_3","label":"Product 3 description"},{"type":"richtext","id":"description_4","label":"Product 4 description"},{"type":"richtext","id":"description_5","label":"Product 5 description"},{"type":"richtext","id":"description_6","label":"Product 6 description"},{"type":"richtext","id":"description_7","label":"Product 7 description"},{"type":"richtext","id":"description_8","label":"Product 8 description"},{"type":"richtext","id":"description_9","label":"Product 9 description"},{"type":"richtext","id":"description_10","label":"Product 10 description"},{"type":"richtext","id":"description_11","label":"Product 11 description"},{"type":"richtext","id":"description_12","label":"Product 12 description"},{"type":"header","content":"Image"},{"type":"select","id":"image_ratio","label":"Image ratio","options":[{"value":"1 / 1","label":"Square"},{"value":"4 / 5","label":"Portrait"},{"value":"3 / 2","label":"Landscape"}],"default":"1 / 1"},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"}],"default":"contain"},{"type":"header","content":"Typography"},{"type":"range","id":"product_title_size","label":"Product title size","min":12,"max":32,"step":1,"unit":"px","default":18},{"type":"range","id":"price_size","label":"Price size","min":12,"max":32,"step":1,"unit":"px","default":18},{"type":"range","id":"text_size","label":"Body text size","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"header","content":"Variant buttons"},{"type":"range","id":"variant_size","label":"Button height","min":28,"max":60,"step":2,"unit":"px","default":40},{"type":"range","id":"variant_gap","label":"Button gap","min":2,"max":20,"step":2,"unit":"px","default":8},{"type":"range","id":"variant_radius","label":"Button radius","min":0,"max":30,"step":2,"unit":"px","default":4},{"type":"header","content":"Colors and buttons"},{"type":"color","id":"section_color","label":"Section background","default":"#FFFFFF"},{"type":"color","id":"card_color","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Card border","default":"#DDDDDD"},{"type":"color","id":"title_color","label":"Title","default":"#000000"},{"type":"color","id":"price_color","label":"Price","default":"#000000"},{"type":"color","id":"text_color","label":"Text","default":"#333333"},{"type":"color","id":"variant_bg","label":"Variant background","default":"#FFFFFF"},{"type":"color","id":"variant_text","label":"Variant text","default":"#222222"},{"type":"color","id":"variant_border","label":"Variant border","default":"#777777"},{"type":"color","id":"variant_selected_bg","label":"Selected variant background","default":"#000000"},{"type":"color","id":"variant_selected_text","label":"Selected variant text","default":"#FFFFFF"},{"type":"color","id":"button_color","label":"Add button background","default":"#000000"},{"type":"color","id":"button_text_color","label":"Add button text","default":"#FFFFFF"},{"type":"range","id":"button_radius","label":"Add button radius","min":0,"max":30,"step":2,"unit":"px","default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}