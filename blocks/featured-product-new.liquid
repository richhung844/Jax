flex-wrap:wrap;justify-content:{{ block.settings.callout_alignment }};gap:18px;margin:8px 0 24px}.ai-featured-{{ ai_gen_id }}__callout{display:flex;align-items:center;gap:10px;text-align:left;max-width:100%;color:{{ block.settings.callout_text_color }}}.ai-featured-{{ ai_gen_id }}__callout-icon,.ai-featured-{{ ai_gen_id }}__callout svg{width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;object-fit:contain;flex:0 0 auto;color:{{ block.settings.icon_color }}}.ai-featured-{{ ai_gen_id }}__callout strong,.ai-featured-{{ ai_gen_id }}__callout span{display:block}.ai-featured-{{ ai_gen_id }}__callout strong{color:{{ block.settings.callout_heading_color }}}.ai-featured-{{ ai_gen_id }}__callout a{color:inherit;text-decoration:none}.ai-featured-{{ ai_gen_id }} a:focus-visible,.ai-featured-{{ ai_gen_id }} button:focus-visible{outline:2px solid currentColor;outline-offset:3px}.ai-featured-{{ ai_gen_id }}__button-row{display:flex;justify-content:{{ block.settings.button_alignment }}}.ai-featured-{{ ai_gen_id }}__button-row--full{display:block}.ai-featured-{{ ai_gen_id }}__button{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:12px 28px;border:1px solid {{ block.settings.button_color }};background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;text-decoration:none;cursor:pointer}.ai-featured-{{ ai_gen_id }}__button:hover{background:{{ block.settings.button_hover_color }};border-color:{{ block.settings.button_hover_color }};color:{{ block.settings.button_hover_text_color }}}.ai-featured-{{ ai_gen_id }}__button-row--full .ai-featured-{{ ai_gen_id }}__button{width:100%}.ai-featured-{{ ai_gen_id }}__error{color:#9b1c1c;margin-top:10px}@media(max-width:749px){.ai-featured-{{ ai_gen_id }}__header{width:100%}.ai-featured-{{ ai_gen_id }}__grid{grid-template-columns:1fr}.ai-featured-{{ ai_gen_id }}--image-first .ai-featured-{{ ai_gen_id }}__media{order:0}.ai-featured-{{ ai_gen_id }}--image-first .ai-featured-{{ ai_gen_id }}__content{order:1}.ai-featured-{{ ai_gen_id }}--content-first .ai-featured-{{ ai_gen_id }}__content{order:0}.ai-featured-{{ ai_gen_id }}--content-first .ai-featured-{{ ai_gen_id }}__media{order:1}}
{% endstyle %}
<featured-product-{{ ai_gen_id }} class="ai-featured-{{ ai_gen_id }} ai-featured-{{ ai_gen_id }}--{{ block.settings.mobile_order }}" {{ block.shopify_attributes }}>
{% if block.settings.show_header %}<div class="ai-featured-{{ ai_gen_id }}__header">{% if block.settings.section_heading != blank %}<h2>{{ block.settings.section_heading | escape }}</h2>{% endif %}{% if block.settings.section_subheading != blank %}<div>{{ block.settings.section_subheading }}</div>{% endif %}{% if block.settings.header_link != blank and block.settings.header_link_label != blank %}<a href="{{ block.settings.header_link }}">{{ block.settings.header_link_label | escape }}</a>{% endif %}</div>{% endif %}
<div class="ai-featured-{{ ai_gen_id }}__grid"><div class="ai-featured-{{ ai_gen_id }}__content">{% if featured_product != blank %}{% if block.settings.badge_label != blank %}{% if block.settings.badge_link != blank %}<a class="ai-featured-{{ ai_gen_id }}__badge" href="{{ block.settings.badge_link }}">{{ block.settings.badge_label | escape }}</a>{% else %}<span class="ai-featured-{{ ai_gen_id }}__badge">{{ block.settings.badge_label | escape }}</span>{% endif %}{% endif %}<h2>{{ block.settings.custom_title | default: featured_product.title | escape }}</h2><div class="ai-featured-{{ ai_gen_id }}__price">{% if featured_variant.compare_at_price > featured_variant.price %}<s>{{ featured_variant.compare_at_price | money }}</s> {% endif %}<span>{{ featured_variant.price | money }}</span></div>{% if block.settings.custom_description != blank %}<div class="ai-featured-{{ ai_gen_id }}__description">{{ block.settings.custom_description }}</div>{% endif %}{% if block.settings.learn_more_url != blank and block.settings.learn_more_label != blank %}<p><a href="{{ block.settings.learn_more_url }}">{{ block.settings.learn_more_label | escape }}</a></p>{% endif %}
<div class="ai-featured-{{ ai_gen_id }}__callouts">{% for i in (1..3) %}{% liquid
assign title_key='callout_' | append:i | append:'_heading'
assign text_key='callout_' | append:i | append:'_text'
assign image_key='callout_' | append:i | append:'_image'
assign url_key='callout_' | append:i | append:'_url'
assign heading_link_key='callout_' | append:i | append:'_heading_link'
