{% if featured_variant != blank %}<div class="ai-featured-{{ ai_gen_id }}__button-row{% if block.settings.button_alignment == 'full' %} ai-featured-{{ ai_gen_id }}__button-row--full{% endif %}"><button type="button" class="ai-featured-{{ ai_gen_id }}__button" data-add-button data-variant-id="{{ featured_variant.id }}" {% unless featured_variant.available %}disabled{% endunless %}>{% if featured_variant.available %}{{ block.settings.button_label | escape }}{% else %}Sold out{% endif %}</button></div><div class="ai-featured-{{ ai_gen_id }}__error" data-error role="alert" hidden></div>{% endif %}{% else %}<p>Select a product in the block settings to display it.</p>{% endif %}</div><div class="ai-featured-{{ ai_gen_id }}__media">{% assign display_image=block.settings.image_override | default:featured_product.featured_image %}{% if display_image != blank %}<img class="ai-featured-{{ ai_gen_id }}__image" src="{{ display_image | image_url: width: 1600 }}" alt="{{ display_image.alt | default:featured_product.title | escape }}" loading="lazy" width="{{ display_image.width }}" height="{{ display_image.height }}">{% else %}<div class="ai-featured-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<p>Add a product or choose an image.</p></div>{% endif %}</div></div></featured-product-{{ ai_gen_id }}>
<script>
(function () {
  const tag = 'featured-product-{{ ai_gen_id }}';

  if (customElements.get(tag)) return;

  class FeaturedProduct{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('[data-add-button]');
      this.error = this.querySelector('[data-error]');
      this.cart =
        document.querySelector('cart-notification') ||
        document.querySelector('cart-drawer');

      if (this.button) {
        this.button.addEventListener('click', () => this.addItem());
      }
    }

    async addItem() {
      if (!this.button || this.button.disabled) return;

      const button = this.button;
      const variantId = button.dataset.variantId;

      if (!variantId) {
        this.showError('Product variant could not be found.');
        return;
      }

      button.disabled = true;

      if (this.error) {
        this.error.hidden = true;
        this.error.textContent = '';
      }

      try {
        const config = fetchConfig('javascript');

        config.headers['X-Requested-With'] = 'XMLHttpRequest';
        delete config.headers['Content-Type'];

        const formData = new FormData();

        formData.append('id', variantId);
        formData.append('quantity', '1');

        /*
         * Ask Luxe/Shopify to return the exact sections
         * required by the existing cart drawer.
         */
        if (this.cart) {
          formData.append(
            'sections',
            this.cart
              .getSectionsToRender()
              .map((section) => section.id)
          );

          formData.append(
            'sections_url',
            window.location.pathname
          );

          if (typeof this.cart.setActiveElement === 'function') {
            this.cart.setActiveElement(document.activeElement);
          }
        }

        config.body = formData;

        const response = await fetch(
          routes.cart_add_url,
          config
        );

        const result = await response.json();

        /*
         * Shopify returned an add-to-cart error.
         */
        if (result.status) {
          if (
            typeof publish === 'function' &&
            typeof PUB_SUB_EVENTS !== 'undefined'
          ) {
            publish(PUB_SUB_EVENTS.cartError, {
              source: 'featured-product',
              productVariantId: variantId,
              errors: result.errors || result.description,
              message: result.message
            });
          }

          throw new Error(
            result.description ||
            result.message ||
            'Unable to add this product.'
          );
        }

        /*
         * Publish the same Luxe cart update event
         * used by product-form.js.
         */
        if (
          typeof publish === 'function' &&
          typeof PUB_SUB_EVENTS !== 'undefined'
        ) {
          publish(PUB_SUB_EVENTS.cartUpdate, {
            source: 'featured-product',
            productVariantId: variantId,
            cartData: result
          });
        }

        /*
         * THIS is the important part:
         * give Luxe the response containing its newly
         * rendered cart drawer sections.
         */
        if (
          this.cart &&
          typeof this.cart.renderContents === 'function'
        ) {
          this.cart.renderContents(result);

          if (this.cart.classList.contains('is-empty')) {
            this.cart.classList.remove('is-empty');
          }
        } else {
          throw new Error(
            'The Luxe cart drawer could not be loaded.'
          );
        }

      } catch (error) {
        console.error(
          'Featured Product Add to Bag:',
          error
        );

        this.showError(
          error.message ||
          'Unable to add this product. Please try again.'
        );
      } finally {
        button.disabled = false;
      }
    }

    showError(message) {
      if (!this.error) return;

      this.error.textContent = message;
      this.error.hidden = false;
    }
  }

  customElements.define(
    tag,
    FeaturedProduct{{ ai_gen_id }}
  );
})();
</script>
