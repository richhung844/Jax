{% doc %}
  @prompt
    comparison table
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow-x: auto;
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-comparison-table__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    border-spacing: 0;
  }

  .ai-comparison-table__header-cell-{{ ai_gen_id }} {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    font-weight: 600;
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    font-size: {{ block.settings.header_font_size }}px;
  }

  .ai-comparison-table__cell-{{ ai_gen_id }} {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.cell_bg_color }};
    color: {{ block.settings.cell_text_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    font-size: {{ block.settings.cell_font_size }}px;
  }

  .ai-comparison-table__row-{{ ai_gen_id }}:nth-child(even) .ai-comparison-table__cell-{{ ai_gen_id }} {
    {% if block.settings.alternate_row_color %}
      background-color: {{ block.settings.alternate_bg_color }};
    {% endif %}
  }

  .ai-comparison-table__feature-cell-{{ ai_gen_id }} {
    font-weight: 600;
    background-color: {{ block.settings.feature_bg_color }};
    color: {{ block.settings.feature_text_color }};
  }

  .ai-comparison-table__checkmark-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.checkmark_color }};
  }

  .ai-comparison-table__cross-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.cross_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table__wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.6 }}px;
    }

    .ai-comparison-table__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-comparison-table__header-cell-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }

    .ai-comparison-table__cell-{{ ai_gen_id }} {
      font-size: {{ block.settings.cell_font_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<comparison-table-{{ ai_gen_id }}
  class="ai-comparison-table-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-comparison-table__wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-comparison-table__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <table class="ai-comparison-table__table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.feature_column_label }}</th>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.column_1_label }}</th>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.column_2_label }}</th>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.column_3_label }}</th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..10) %}
          {% liquid
            assign feature_key = 'row_' | append: i | append: '_feature'
            assign col1_key = 'row_' | append: i | append: '_col1'
            assign col2_key = 'row_' | append: i | append: '_col2'
            assign col3_key = 'row_' | append: i | append: '_col3'

            assign feature = block.settings[feature_key]
            assign col1 = block.settings[col1_key]
            assign col2 = block.settings[col2_key]
            assign col3 = block.settings[col3_key]
          %}

          {% if feature != blank %}
            <tr class="ai-comparison-table__row-{{ ai_gen_id }}">
              <td class="ai-comparison-table__cell-{{ ai_gen_id }} ai-comparison-table__feature-cell-{{ ai_gen_id }}">
                {{ feature }}
              </td>
              <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
                {% if col1 == 'yes' %}
                  <svg class="ai-comparison-table__checkmark-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif col1 == 'no' %}
                  <svg class="ai-comparison-table__cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% else %}
                  {{ col1 }}
                {% endif %}
              </td>
              <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
                {% if col2 == 'yes' %}
                  <svg class="ai-comparison-table__checkmark-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif col2 == 'no' %}
                  <svg class="ai-comparison-table__cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% else %}
                  {{ col2 }}
                {% endif %}
              </td>
              <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
                {% if col3 == 'yes' %}
                  <svg class="ai-comparison-table__checkmark-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif col3 == 'no' %}
                  <svg class="ai-comparison-table__cross-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% else %}
                  {{ col3 }}
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</comparison-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ComparisonTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('comparison-table-{{ ai_gen_id }}', ComparisonTable{{ ai_gen_id }});
  })();
</script>

